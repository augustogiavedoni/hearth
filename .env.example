# Copy to `.env` and fill in locally. `.env` is git-ignored: never commit it.
# Only variable NAMES live here; no values, not even fake ones.

# Primary model provider (any OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Fallback provider, used by the router when the primary returns HTTP 429
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Gmail (paths to OAuth files kept outside the repo or under data/)
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
